{% import "components/form/fields_macros.html.twig" as fields %}

<div class="passvault-item-block">
    <form
        method="post"
        action="{{ 'GlpiPlugin\\Passvault\\Credential_Item'|itemtype_form_path }}"
        class="mb-3 d-flex flex-wrap align-items-end gap-2"
    >
        <input
            type="hidden"
            name="plugin_passvault_credentials_id"
            value="{{ credential.fields['id'] }}"
        >
        <input
            type="hidden"
            name="_glpi_csrf_token"
            value="{{ csrf_token() }}"
        >
        <div class="flex-grow-1">
            {{ fields.dropdownAllItems(
                'itemtype_items_id',
                '',
                __('Link a device, user or group', 'passvault')
            ) }}
        </div>
        <button class="btn btn-primary" type="submit" name="add_item" value="1">
            <i class="ti ti-link"></i>
            {{ __('Link', 'passvault') }}
        </button>
    </form>

    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>{{ __('Type') }}</th>
                <th>{{ __('Name') }}</th>
                <th class="text-end">{{ __('Action', 'passvault') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for row in linked_items %}
                <tr>
                    <td>
                        {{ row.itemtype|split('\\')|last }}
                    </td>
                    <td>
                        {% if row.url %}
                            <a href="{{ row.url }}">{{ row.name }}</a>
                        {% else %}
                            {{ row.name }}
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <form
                            method="post"
                            action="{{ 'GlpiPlugin\\Passvault\\Credential_Item'|itemtype_form_path }}"
                            class="d-inline"
                        >
                            <input type="hidden" name="id" value="{{ row.link_id }}">
                            <input
                                type="hidden"
                                name="_glpi_csrf_token"
                                value="{{ csrf_token() }}"
                            >
                            <button
                                class="btn btn-sm btn-outline-danger"
                                type="submit"
                                name="delete_item"
                                value="1"
                                title="{{ __('Unlink', 'passvault') }}"
                            >
                                <i class="ti ti-unlink"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center text-muted">
                        {{ __('No device linked yet.', 'passvault') }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
