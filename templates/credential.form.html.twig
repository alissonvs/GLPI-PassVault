{% extends "generic_show_form.html.twig" %}
{% import "components/form/fields_macros.html.twig" as fields %}

{% block more_fields %}
    {% if params.id is defined and params.id > 0 %}
        <input type="hidden" name="id" value="{{ params.id }}">
    {% endif %}

    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

    {{ fields.textField(
        'name',
        item.fields['name']|default(''),
        __('Name') ~ ' *'
    ) }}

    {{ fields.textareaField(
        'description',
        item.fields['description']|default(''),
        __('Description')
    ) }}

    <div class="mb-3">
        <label class="form-label" for="passvault_type">
            {{ __('Type', 'passvault') }}
        </label>
        <select
            id="passvault_type"
            name="type"
            class="form-select"
        >
            {% for key, label in type_options %}
                <option value="{{ key }}" {% if key == current_type %}selected{% endif %}>
                    {{ label }}
                </option>
            {% endfor %}
        </select>
    </div>

    {{ fields.textField(
        'username',
        item.fields['username']|default(''),
        __('Username')
    ) }}

    <div class="mb-3 passvault-password-block">
        <label class="form-label" for="passvault_password_field">
            {{ __('Password') }}
        </label>
        <div class="input-group">
            <input
                type="password"
                class="form-control"
                id="passvault_password_field"
                name="password"
                value="{{ decrypted_password|e }}"
                autocomplete="new-password"
            >
            <button
                type="button"
                class="btn btn-outline-secondary"
                id="passvault_password_toggle"
                title="{{ __('Show/hide password', 'passvault') }}"
            >
                <i class="ti ti-eye"></i>
            </button>
            <button
                type="button"
                class="btn btn-outline-secondary"
                id="passvault_password_copy"
                title="{{ __('Copy to clipboard', 'passvault') }}"
            >
                <i class="ti ti-copy"></i>
            </button>
            <button
                type="button"
                class="btn btn-outline-secondary"
                id="passvault_password_random"
                title="{{ __('Generate a random password', 'passvault') }}"
            >
                <i class="ti ti-refresh"></i>
            </button>
        </div>
        <small class="form-text text-muted">
            {{ __('Leaving the field blank keeps the current value.', 'passvault') }}
        </small>
    </div>

    {{ fields.textField(
        'url',
        item.fields['url']|default(''),
        __('URL')
    ) }}
{% endblock %}
